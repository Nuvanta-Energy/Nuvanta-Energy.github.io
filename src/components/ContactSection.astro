<section id="contact">
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-info reveal">
        <div class="eyebrow">Get in touch</div>
        <h3>Tell us about your interconnection.</h3>
        <p>Whether you're at feasibility stage or facing a stalled SLDC submission, we can usually tell you within one call what the actual blocker is.</p>

        <div class="contact-line">
          <div class="k">Email</div>
          <div class="v"><a href="mailto:contact@nuvantaenergy.com">contact@nuvantaenergy.com</a></div>
        </div>
        <div class="contact-line">
          <div class="k">Phone</div>
          <div class="v"><a href="tel:+911234567890">+91 12345 67890</a></div>
        </div>
        <div class="contact-line">
          <div class="k">Office</div>
          <div class="v">India — projects across India &amp; UAE</div>
        </div>
        <div class="contact-line">
          <div class="k">Response</div>
          <div class="v">Within 1 business day</div>
        </div>
      </div>

      <div class="form-panel reveal">
        <form id="contactForm">
          <div class="form-row">
            <div class="field">
              <label for="fname">Full name</label>
              <input type="text" id="fname" name="fname" required>
            </div>
            <div class="field">
              <label for="org">Organisation</label>
              <input type="text" id="org" name="org" required>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone">
            </div>
          </div>
          <div class="field">
            <label for="service">Area of interest</label>
            <select id="service" name="service">
              <option>CEA / SLDC approvals</option>
              <option>PSS®E simulation</option>
              <option>PSCAD studies</option>
              <option>Real-time control integration</option>
              <option>Storage-backed hybrid design</option>
              <option>Other / not sure yet</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Project details</label>
            <textarea id="message" name="message" placeholder="Plant capacity, technology (solar/wind/hybrid), interconnection stage, and current blocker if any."></textarea>
          </div>
          <input class="form-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button type="submit" class="form-submit" id="formSubmitBtn">Request a consultation</button>
          <div class="form-note">No spam. We respond directly from a project engineer, not a sales inbox.</div>
          <div class="form-success" id="formSuccess">
            ✓ &nbsp;Request received. A project engineer will follow up within one business day.
          </div>
          <div class="form-error" id="formError">
            Something went wrong — please email us directly at <a href="mailto:contact@nuvantaenergy.com">contact@nuvantaenergy.com</a>.
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
