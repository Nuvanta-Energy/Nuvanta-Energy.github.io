# Google Cloud service account with Editor access to the target spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_NAME=Leads

# Telegram bot credentials from BotFather and the destination chat or channel ID.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# Optional public URL of a separately deployed contact API, required on GitHub Pages.
PUBLIC_CONTACT_API_URL=https://your-contact-api.example.com/contact
